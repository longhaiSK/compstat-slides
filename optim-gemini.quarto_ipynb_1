    "---\n",
    "title: \"Optimization Algorithms Animation\"\n",
    "format:\n",
    "  html:\n",
    "    resources: \n",
    "      - shinylive-sw.js\n",
    "filters:\n",
    "  - shinylive\n",
    "---\n",
    "\n",
    "This interactive animation demonstrates how different optimization algorithms navigate bivariate surfaces. \n",
    "\n",
    "* **Orange Arrow:** The gradient $\\nabla f$ at the current point (normalized for visibility). It points in the direction of steepest *ascent*.\n",
    "* **Green Arrow:** The actual step $p_k$ taken by the algorithm.\n",
    "\n",
    "```{shinylive-r}\n",
    "#| standalone: true\n",
    "#| viewerHeight: 700\n",
    "\n",
    "library(shiny)\n",
    "library(bslib)\n",
    "library(ggplot2)\n",
    "\n",
    "# --- Objective Functions Definition ---\n",
    "fns <- list(\n",
    "  \"Good Quadratic\" = list(\n",
    "    f = function(x) x[1]^2 + x[2]^2,\n",
    "    g = function(x) c(2*x[1], 2*x[2]),\n",
    "    H = function(x) matrix(c(2,0,0,2), 2, 2),\n",
    "    xlim = c(-2, 2), ylim = c(-2, 2),\n",
    "    default_start = c(-1.8, -1.2)\n",
    "  ),\n",
    "  \"Narrow Ridge (Rosenbrock)\" = list(\n",
    "    f = function(x) (1-x[1])^2 + 100*(x[2]-x[1]^2)^2,\n",
    "    g = function(x) c(-2*(1-x[1]) - 400*x[1]*(x[2]-x[1]^2), 200*(x[2]-x[1]^2)),\n",
    "    H = function(x) matrix(c(2-400*x[2]+1200*x[1]^2, -400*x[1], -400*x[1], 200), 2, 2),\n",
    "    xlim = c(-2, 2), ylim = c(-1, 3),\n",
    "    default_start = c(-1.5, 2.5)\n",
    "  ),\n",
    "  \"Multi-Mode (Himmelblau)\" = list(\n",
    "    f = function(x) (x[1]^2+x[2]-11)^2 + (x[1]+x[2]^2-7)^2,\n",
    "    g = function(x) c(4*x[1]*(x[1]^2+x[2]-11) + 2*(x[1]+x[2]^2-7), \n",
    "                      2*(x[1]^2+x[2]-11) + 4*x[2]*(x[1]+x[2]^2-7)),\n",
    "    H = function(x) matrix(c(12*x[1]^2 + 4*x[2] - 42, 4*x[1] + 4*x[2],\n",
    "                             4*x[1] + 4*x[2], 4*x[1] + 12*x[2]^2 - 26), 2, 2),\n",
    "    xlim = c(-5, 5), ylim = c(-5, 5),\n",
    "    default_start = c(-4, -4)\n",
    "  )\n",
    ")\n",
    "\n",
    "# --- Backtracking Line Search ---\n",
    "line_search <- function(f, g, x, p, max_iter=20) {\n",
    "  a <- 1\n",
    "  c1 <- 1e-4\n",
    "  fx <- f(x)\n",
    "  gx <- g(x)\n",
    "  for(i in 1:max_iter) {\n",
    "    if(f(x + a*p) <= fx + c1*a*sum(gx*p)) break\n",
    "    a <- a * 0.5\n",
    "  }\n",
    "  return(a)\n",
    "}\n",
    "\n",
    "# --- Core Optimization Engine ---\n",
    "run_optim <- function(method, fn, x0, max_iter=50) {\n",
    "  f <- fn$f; g <- fn$g; H <- fn$H\n",
    "  x <- x0\n",
    "  path <- data.frame(iter=1, x=x[1], y=x[2], gx=NA, gy=NA, dx=NA, dy=NA)\n",
    "  \n",
    "  B <- diag(2)\n",
    "  p_old <- rep(0, 2)\n",
    "  gx_old <- rep(0, 2)\n",
    "  \n",
    "  for(k in 1:max_iter) {\n",
    "    gx <- g(x)\n",
    "    if(sqrt(sum(gx^2)) < 1e-4) break # Converged\n",
    "    \n",
    "    # Calculate search direction\n",
    "    if(method == \"GD + Line Search\") {\n",
    "      pk <- -gx\n",
    "    } else if(method == \"Newton-Raphson\") {\n",
    "      Hk <- H(x)\n",
    "      # Ensure positive definiteness to force descent direction\n",
    "      eig <- eigen(Hk)$values\n",
    "      if(min(eig) < 1e-5) Hk <- Hk + diag(2) * (abs(min(eig)) + 1e-2)\n",
    "      pk <- -solve(Hk, gx)\n",
    "    } else if(method == \"BFGS\") {\n",
    "      pk <- - as.vector(B %*% gx)\n",
    "    } else if(method == \"Conjugate Gradient\") {\n",
    "      if(k == 1) {\n",
    "        pk <- -gx\n",
    "      } else {\n",
    "        beta <- sum(gx^2) / sum(gx_old^2) # Fletcher-Reeves\n",
    "        pk <- -gx + beta * p_old\n",
    "      }\n",
    "    }\n",
    "    \n",
    "    # Step size\n",
    "    alpha <- line_search(f, g, x, pk)\n",
    "    x_next <- x + alpha * pk\n",
    "    \n",
    "    # BFGS Update\n",
    "    if(method == \"BFGS\") {\n",
    "      sk <- x_next - x\n",
    "      yk <- g(x_next) - gx\n",
    "      rho <- 1/sum(yk*sk)\n",
    "      if(rho > 0 && !is.infinite(rho)) {\n",
    "        I <- diag(2)\n",
    "        B <- (I - rho * sk %*% t(yk)) %*% B %*% (I - rho * yk %*% t(sk)) + rho * sk %*% t(sk)\n",
    "      }\n",
    "    }\n",
    "    \n",
    "    # Save path data\n",
    "    path$gx[k] <- gx[1]\n",
    "    path$gy[k] <- gx[2]\n",
    "    path$dx[k] <- x_next[1] - x[1]\n",
    "    path$dy[k] <- x_next[2] - x[2]\n",
    "    \n",
    "    x_old <- x; gx_old <- gx; p_old <- pk\n",
    "    x <- x_next\n",
    "    \n",
    "    path <- rbind(path, data.frame(iter=k+1, x=x[1], y=x[2], gx=NA, gy=NA, dx=NA, dy=NA))\n",
    "  }\n",
    "  return(path)\n",
    "}\n",
    "\n",
    "# --- Shiny UI ---\n",
    "ui <- page_sidebar(\n",
    "  title = \"Bivariate Optimization Animation\",\n",
    "  sidebar = sidebar(\n",
    "    selectInput(\"func\", \"Objective Function:\", choices = names(fns)),\n",
    "    selectInput(\"algo\", \"Algorithm:\", choices = c(\"GD + Line Search\", \"Newton-Raphson\", \"Conjugate Gradient\", \"BFGS\")),\n",
    "    fluidRow(\n",
    "      column(6, numericInput(\"start_x\", \"Start X:\", value = -1.8, step = 0.5)),\n",
    "      column(6, numericInput(\"start_y\", \"Start Y:\", value = -1.2, step = 0.5))\n",
    "    ),\n",
    "    actionButton(\"run\", \"Compute Path\", class = \"btn-primary\", width = \"100%\"),\n",
    "    hr(),\n",
    "    uiOutput(\"slider_ui\"),\n",
    "    p(\"Click the Play button above to animate the steps.\", style = \"font-size: 0.85em; color: gray;\")\n",
    "  ),\n",
    "  card(\n",
    "    plotOutput(\"optim_plot\", height = \"600px\")\n",
    "  )\n",
    ")\n",
    "\n",
    "# --- Shiny Server ---\n",
    "server <- function(input, output, session) {\n",
    "  \n",
    "  # Update default start coordinates when function changes\n",
    "  observeEvent(input$func, {\n",
    "    req(input$func)\n",
    "    defaults <- fns[[input$func]]$default_start\n",
    "    updateNumericInput(session, \"start_x\", value = defaults[1])\n",
    "    updateNumericInput(session, \"start_y\", value = defaults[2])\n",
    "  })\n",
    "  \n",
    "  # Reactive optimization calculation\n",
    "  optim_data <- eventReactive(input$run, {\n",
    "    fn <- fns[[input$func]]\n",
    "    run_optim(input$algo, fn, c(input$start_x, input$start_y))\n",
    "  }, ignoreNULL = FALSE)\n",
    "  \n",
    "  # Render dynamic animation slider\n",
    "  output$slider_ui <- renderUI({\n",
    "    path <- optim_data()\n",
    "    max_steps <- max(1, nrow(path) - 1)\n",
    "    sliderInput(\"step\", \"Animation Step:\", \n",
    "                min = 1, max = max_steps, value = 1, step = 1,\n",
    "                animate = animationOptions(interval = 800, loop = FALSE))\n",
    "  })\n",
    "  \n",
    "  # Background contour data caching\n",
    "  contour_grid <- reactive({\n",
    "    fn <- fns[[input$func]]\n",
    "    x_seq <- seq(fn$xlim[1], fn$xlim[2], length.out = 100)\n",
    "    y_seq <- seq(fn$ylim[1], fn$ylim[2], length.out = 100)\n",
    "    grid <- expand.grid(x = x_seq, y = y_seq)\n",
    "    grid$z <- apply(grid, 1, fn$f)\n",
    "    # Log scale z for better visual contours, especially on Rosenbrock\n",
    "    grid$z <- log10(grid$z - min(grid$z) + 1e-4) \n",
    "    return(list(grid=grid, fn=fn))\n",
    "  })\n",
    "  \n",
    "  # Main Plot\n",
    "  output$optim_plot <- renderPlot({\n",
    "    req(input$step)\n",
    "    path <- optim_data()\n",
    "    cg <- contour_grid()\n",
    "    \n",
    "    current_step <- input$step\n",
    "    path_to_current <- path[1:current_step, ]\n",
    "    current_pt <- path[current_step, ]\n",
    "    \n",
    "    p <- ggplot() +\n",
    "      geom_contour(data = cg$grid, aes(x=x, y=y, z=z), bins = 25, color = \"grey70\") +\n",
    "      geom_path(data = path_to_current, aes(x=x, y=y), color = \"black\", linewidth = 0.8) +\n",
    "      geom_point(data = path_to_current, aes(x=x, y=y), size = 2) +\n",
    "      coord_cartesian(xlim = cg$fn$xlim, ylim = cg$fn$ylim) +\n",
    "      theme_minimal() +\n",
    "      labs(x = \"X\", y = \"Y\", title = paste(input$algo, \"on\", input$func))\n",
    "    \n",
    "    # If not the last step, draw arrows\n",
    "    if(!is.na(current_pt$gx) && !is.na(current_pt$dx)) {\n",
    "      \n",
    "      # 1. Normalize gradient vector length for clear visualization\n",
    "      g_mag <- sqrt(current_pt$gx^2 + current_pt$gy^2)\n",
    "      arrow_len <- (cg$fn$xlim[2] - cg$fn$xlim[1]) * 0.1 # Length = 10% of plot width\n",
    "      scaled_gx <- (current_pt$gx / g_mag) * arrow_len\n",
    "      scaled_gy <- (current_pt$gy / g_mag) * arrow_len\n",
    "      \n",
    "      # 2. Draw Gradient (Orange)\n",
    "      p <- p + geom_segment(\n",
    "        aes(x = current_pt$x, y = current_pt$y, \n",
    "            xend = current_pt$x + scaled_gx, yend = current_pt$y + scaled_gy),\n",
    "        color = \"orange\", arrow = arrow(length = unit(0.3, \"cm\"), type=\"closed\"), \n",
    "        linewidth = 1.2\n",
    "      )\n",
    "      \n",
    "      # 3. Draw Actual Jump Step (Green)\n",
    "      p <- p + geom_segment(\n",
    "        aes(x = current_pt$x, y = current_pt$y, \n",
    "            xend = current_pt$x + current_pt$dx, yend = current_pt$y + current_pt$dy),\n",
    "        color = \"green\", arrow = arrow(length = unit(0.3, \"cm\"), type=\"closed\"), \n",
    "        linewidth = 1.2\n",
    "      )\n",
    "      \n",
    "      # Add Legend Annotations manually for clarity\n",
    "      p <- p + annotate(\"text\", x = cg$fn$xlim[1], y = cg$fn$ylim[2], \n",
    "                        label = \"Orange: Gradient (Direction of Steepest Ascent)\\nGreen: Actual Optimization Step\", \n",
    "                        hjust = 0, vjust = 1, color = \"black\", fontface = \"bold\", size = 4)\n",
    "    }\n",
    "    \n",
    "    return(p)\n",
    "  })\n",
    "}\n",
    "\n",
    "shinyApp(ui, server)\n",
    "```"
   ]
  }
